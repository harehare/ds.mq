import "ds"

# Each bench grows one structure through its public API. Compare the timings of the `_small` and
# `_large` pairs: a ratio near the size ratio means the updates run in place; a ratio near its square
# means every update copies the structure.

def push_many(n):
  var h = ds::heap::new()
  | var i = 0
  | let _ = while (i < n):
      h = ds::heap::push(h, n - i)
      | i = i + 1
    end
  | ds::heap::size(h)
end

def insert_many(n):
  var t = ds::trie::new()
  | var i = 0
  | let _ = while (i < n):
      t = ds::trie::insert(t, "w" + to_string(i))
      | i = i + 1
    end
  | len(keys(t))
end

def chain(n):
  var uf = ds::unionfind::new(n)
  | var i = 0
  | let _ = while (i < n - 1):
      uf = ds::unionfind::union(uf, i, i + 1)
      | i = i + 1
    end
  | ds::unionfind::count(uf)
end

def churn(n):
  var d = ds::deque::new()
  | var i = 0
  | let _ = while (i < n):
      d = if (i % 2 == 0): ds::deque::push_back(d, i) else: ds::deque::push_front(d, i)
      | i = i + 1
    end
  | var total = 0
  | let _ = while (!ds::deque::is_empty(d)):
      d = if (total % 2 == 0): ds::deque::pop_front(d)[1] else: ds::deque::pop_back(d)[1]
      | total = total + 1
    end
  | total
end

def scrambled(n): map(range(n), fn(i): (i * 7919) % n;);

def bench_heap_push_small(): push_many(2000);

def bench_heap_push_large(): push_many(8000);

def bench_heap_from_and_drain(): len(ds::heap::to_sorted(ds::heap::from(scrambled(5000), false)));

def bench_heap_largest_of_many(): ds::heap::largest(scrambled(20000), 10);

def bench_trie_insert_small(): insert_many(1000);

def bench_trie_insert_large(): insert_many(4000);

def bench_unionfind_chain_small(): chain(2000);

def bench_unionfind_chain_large(): chain(8000);

def bench_unionfind_groups_small(): len(ds::unionfind::groups(ds::unionfind::new(2000)));

def bench_unionfind_groups_large(): len(ds::unionfind::groups(ds::unionfind::new(8000)));

def scan(repeats):
  var t = ds::trie::new()
  | var w = 0
  | let _ = while (w < 40):
      t = ds::trie::insert(t, "term" + to_string(w) + "x")
      | w = w + 1
    end
  | let text = repeat("lorem term7x ipsum dolor term13x sit amet ", repeats)
  | let m = len(text)
  | var i = 0
  | var hits = 0
  | let _ = while (i < m):
      hits = hits + if (is_none(ds::trie::longest_match(t, text, i))): 0 else: 1
      | i = i + 1
    end
  | hits
end

def bench_trie_scan_small(): scan(400);

def bench_trie_scan_large(): scan(1600);

def bench_deque_churn_small(): churn(2000);

def bench_deque_churn_large(): churn(8000);
