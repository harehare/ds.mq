# Data structures for mq: a binary heap, a trie and a union-find.
#
# Every structure is a plain array or dict, so it can be passed around like any other mq value.
# Operations return the updated structure. Write `h = ds::heap::push(h, x)` so the old value is
# not read afterwards: the update then happens in place instead of copying the whole structure.

# A binary heap in one array: [is_max, item1, item2, ...] with the root at index 1.
module heap:
  def _less(x, y, max): if (max): x > y else: x < y;

  # Moves the item at position `start` (1-based) up until its parent is not after it.
  def _up(arr, start, max):
    var a = arr
    | var p = start
    | let _ = while (p > 1):
        let q = floor(p / 2)
        | if (_less(a[p], a[q], max)):
            do
              let t = a[q]
              | a[q] = a[p]
              | a[p] = t
              | p = q
            end
          else:
            p = 1
      end
    | a
  end

  # Moves the item at position `start` down within the first `m` items.
  def _down(arr, start, m, max):
    var a = arr
    | var p = start
    | var go = true
    | let _ = while (go):
        let l = 2 * p
        | if (l > m):
            go = false
          else:
            do
              let r = l + 1
              | let c = if (r <= m && _less(a[r], a[l], max)): r else: l
              | if (_less(a[c], a[p], max)):
                  do
                    let t = a[c]
                    | a[c] = a[p]
                    | a[p] = t
                    | p = c
                  end
                else:
                  go = false
            end
      end
    | a
  end

  # Removes the root and returns the heap without it.
  def _drop_root(h):
    var a = h
    | let n = len(a) - 1
    | let max = a[0]
    | if (n == 0):
        error("heap: the heap is empty")
      else:
        do
          a[1] = a[n]
          | a = slice(a, 0, n)
          | _down(a, 1, n - 1, max)
        end
  end

  # Returns an empty min-heap.
  def new(): [false];

  # Returns an empty max-heap.
  def new_max(): [true];

  # Returns the number of items.
  def size(h): len(h) - 1;

  # Returns the root (the smallest item, or the largest in a max-heap), or None if empty.
  def peek(h): if (len(h) == 1): None else: h[1];

  # Adds an item.
  def push(h, x):
    var a = h
    | let max = a[0]
    | a += [x]
    | let n = len(a) - 1
    | _up(a, n, max)
  end

  # Removes the root and returns [root, heap]. Fails if the heap is empty.
  def pop(h): [peek(h), _drop_root(h)];

  # Builds a heap from an array in linear time.
  def from(arr, max = false):
    let n = len(arr)
    | var a = [max] + arr
    | var p = floor(n / 2)
    | let _ = while (p >= 1):
        a = _down(a, p, n, max)
        | p = p - 1
      end
    | a
  end

  # Returns the items in heap order, root first.
  def to_sorted(h):
    var cur = h
    | var out = []
    | let _ = while (len(cur) > 1):
        out += [cur[1]]
        | cur = _drop_root(cur)
      end
    | out
  end

  # Keeps the `k` best items of `arr` in a heap bounded by `k`.
  def _bounded(arr, k, max):
    var a = [max]
    | let n = len(arr)
    | var i = 0
    | let _ = while (i < n):
        let x = arr[i]
        | a = if (len(a) - 1 < k):
            push(a, x)
          elif (_less(a[1], x, max)):
            do
              a[1] = x
              | let m = len(a) - 1
              | _down(a, 1, m, max)
            end
          else:
            a
        | i = i + 1
      end
    | reverse(to_sorted(a))
  end

  # Returns the `k` largest items of `arr`, largest first.
  def largest(arr, k): if (k <= 0): [] else: _bounded(arr, k, false);

  # Returns the `k` smallest items of `arr`, smallest first.
  def smallest(arr, k): if (k <= 0): [] else: _bounded(arr, k, true);
end

# A trie as a flat dict: each prefix maps to {leaf, kids, value}. Looking up a prefix is one dict
# access, and a word costs one entry per prefix.
module trie:
  # Returns an empty trie.
  def new(): {"": {leaf: false, kids: {}, value: None}};

  # Stores `value` under `word`.
  def put(t, word, value):
    var d = t
    | let n = len(word)
    | var i = 0
    | let _ = while (i <= n):
        let prefix = word[0:i]
        | let node = if (has(d, prefix)): d[prefix] else: {leaf: false, kids: {}, value: None}
        | d = set(d, prefix, if (i < n): set(node, "kids", set(node["kids"], word[i], true)) else: set(set(node, "leaf", true), "value", value))
        | i = i + 1
      end
    | d
  end

  # Adds `word`.
  def insert(t, word): put(t, word, true);

  # Returns true if `word` was stored.
  def contains(t, word): has(t, word) && t[word]["leaf"];

  # Returns the value stored under `word`, or None.
  def lookup(t, word): if (contains(t, word)): t[word]["value"] else: None;

  # Returns true if some stored word starts with `prefix`.
  def has_prefix(t, prefix): has(t, prefix);

  # Returns the stored words starting with `prefix`, sorted.
  def words(t, prefix):
    if (!has(t, prefix)):
      []
    else:
      do
        var queue = [prefix]
        | var head = 0
        | var out = []
        | let _ = while (head < len(queue)):
            let cur = queue[head]
            | let node = t[cur]
            | out += if (node["leaf"]): [cur] else: []
            | queue += map(sort(keys(node["kids"])), fn(c): cur + c;)
            | head = head + 1
          end
        | sort(out)
      end
  end

  # Returns the end (exclusive) of the longest stored word that starts at `start` in `s`, or None.
  def longest_match(t, s, start):
    var i = start
    | var best = None
    | var go = true
    | let _ = while (go):
        let prefix = s[start:i]
        | if (len(prefix) < i - start || !has(t, prefix)):
            go = false
          else:
            do
              best = if (t[prefix]["leaf"] && i > start): i else: best
              | i = i + 1
            end
      end
    | best
  end
end

# A union-find over 0..n-1 in one array: a root holds the negated size of its set, any other
# element holds its parent. Union by size keeps a find at O(log n).
module unionfind:
  def _check(uf, x):
    if (x < 0 || x >= len(uf)): error("unionfind: element out of range: " + to_string(x)) else: x;

  # Returns n singleton sets.
  def new(n):
    var a = []
    | var i = 0
    | let _ = while (i < n):
        a += [-1]
        | i = i + 1
      end
    | a
  end

  # Returns the root of the set containing `x`.
  def find(uf, x):
    var r = _check(uf, x)
    | let _ = while (uf[r] >= 0): r = uf[r];
    | r
  end

  # Merges the sets containing `x` and `y`.
  def union(uf, x, y):
    var rx = x
    | var ry = y
    | let n = len(uf)
    | let _ = if (x < 0 || x >= n || y < 0 || y >= n): error("unionfind: element out of range") else: None
    | let _ = while (uf[rx] >= 0):
        rx = uf[rx]
      end
    | let _ = while (uf[ry] >= 0):
        ry = uf[ry]
      end
    | if (rx == ry):
        uf
      else:
        do
          var a = uf
          | let big = if (a[rx] <= a[ry]): rx else: ry
          | let small = if (big == rx): ry else: rx
          | a[big] = a[big] + a[small]
          | a[small] = big
          | a
        end
  end

  # Returns true if `x` and `y` are in the same set.
  def connected(uf, x, y): find(uf, x) == find(uf, y);

  # Returns the size of the set containing `x`.
  def size_of(uf, x): -uf[find(uf, x)];

  # Returns the number of sets.
  def count(uf): len(filter(uf, fn(v): v < 0;));

  # Returns the sets as arrays of members, ordered by their smallest member.
  def groups(uf):
    if (len(uf) == 0):
      []
    else:
      do
        let pairs = sort(map(range(0, len(uf) - 1), fn(i): [find(uf, i), i];))
        | var out = []
        | var cur = []
        | var root = pairs[0][0]
        | var i = 0
        | let _ = while (i < len(pairs)):
            let _ = if (pairs[i][0] == root):
                cur += [pairs[i][1]]
              else:
                do
                  out += [cur]
                  | cur = [pairs[i][1]]
                  | root = pairs[i][0]
                end
            | i = i + 1
          end
        | out += [cur]
        | sort(out)
      end
  end

  # Returns the sets of n elements joined by `pairs` ([x, y] arrays).
  def from_pairs(n, pairs):
    var a = new(n)
    | var i = 0
    | let _ = while (i < len(pairs)):
        a = union(a, pairs[i][0], pairs[i][1])
        | i = i + 1
      end
    | a
  end
end

# A double-ended queue as a ring buffer in one array: [head, size, capacity, slot, ...].
# The capacity doubles when the buffer is full, so pushes and pops at both ends are O(1) amortized.
module deque:
  def _check(d, i):
    if (i < 0 || i >= d[1]): error("deque: index out of range: " + to_string(i)) else: i;

  # Copies the items in order into a buffer twice as large.
  def _grow(d):
    let n = d[1]
    | let cap = d[2] * 2
    | var items = []
    | var i = 0
    | let _ = while (i < n):
        items += [d[3 + (d[0] + i) % d[2]]]
        | i = i + 1
      end
    | var pad = []
    | var j = n
    | let _ = while (j < cap):
        pad += [None]
        | j = j + 1
      end
    | [0, n, cap] + items + pad
  end

  # Returns an empty deque.
  def new(): [0, 0, 4, None, None, None, None];

  # Returns the number of items.
  def size(d): d[1];

  # Returns true if there are no items.
  def is_empty(d): d[1] == 0;

  # Returns the first item, or None if empty.
  def front(d): if (d[1] == 0): None else: d[3 + d[0]];

  # Returns the last item, or None if empty.
  def back(d): if (d[1] == 0): None else: d[3 + (d[0] + d[1] - 1) % d[2]];

  # Returns the item at position `i` counted from the front.
  def get(d, i): d[3 + (d[0] + _check(d, i)) % d[2]];

  # Adds an item at the back.
  def push_back(d, x):
    var a = d
    | let _ = if (a[1] == a[2]): a = _grow(a) else: None
    | a[3 + (a[0] + a[1]) % a[2]] = x
    | a[1] = a[1] + 1
    | a
  end

  # Adds an item at the front.
  def push_front(d, x):
    var a = d
    | let _ = if (a[1] == a[2]): a = _grow(a) else: None
    | let h = (a[0] + a[2] - 1) % a[2]
    | a[3 + h] = x
    | a[0] = h
    | a[1] = a[1] + 1
    | a
  end

  # Removes the first item and returns [item, deque]. Fails if the deque is empty.
  def pop_front(d):
    var a = d
    | if (a[1] == 0):
        error("deque: the deque is empty")
      else:
        do
          let h = a[0]
          | let item = a[3 + h]
          | a[3 + h] = None
          | a[0] = (h + 1) % a[2]
          | a[1] = a[1] - 1
          | [item, a]
        end
  end

  # Removes the last item and returns [item, deque]. Fails if the deque is empty.
  def pop_back(d):
    var a = d
    | if (a[1] == 0):
        error("deque: the deque is empty")
      else:
        do
          let s = 3 + (a[0] + a[1] - 1) % a[2]
          | let item = a[s]
          | a[s] = None
          | a[1] = a[1] - 1
          | [item, a]
        end
  end

  # Returns the items in order, front first.
  def to_array(d):
    var out = []
    | var i = 0
    | let _ = while (i < d[1]):
        out += [d[3 + (d[0] + i) % d[2]]]
        | i = i + 1
      end
    | out
  end

  # Builds a deque from an array, the first item at the front.
  def from(arr):
    var d = new()
    | var i = 0
    | let _ = while (i < len(arr)):
        d = push_back(d, arr[i])
        | i = i + 1
      end
    | d
  end
end

# A sorted list: a plain array kept in ascending order, with binary search to find positions.
# Duplicates are kept. Items are compared with `<`, so they should all be of one type.
module sorted:
  # Returns an empty sorted list.
  def new(): [];

  # Builds a sorted list from an array.
  def from(arr): sort(arr);

  # Returns the number of items.
  def size(s): len(s);

  # Returns the position of the first item that is not less than `x`, or the size if there is none.
  def lower_bound(s, x):
    var lo = 0
    | var hi = len(s)
    | let _ = while (lo < hi):
        let mid = floor((lo + hi) / 2)
        | if (s[mid] < x): lo = mid + 1 else: hi = mid
      end
    | lo
  end

  # Returns the position of the first item greater than `x`, or the size if there is none.
  def upper_bound(s, x):
    var lo = 0
    | var hi = len(s)
    | let _ = while (lo < hi):
        let mid = floor((lo + hi) / 2)
        | if (s[mid] > x): hi = mid else: lo = mid + 1
      end
    | lo
  end

  # Returns the item at position `i`.
  def get(s, i): if (i < 0 || i >= len(s)): error("sorted: index out of range: " + to_string(i)) else: s[i];

  # Returns the smallest item, or None if empty.
  def first(s): if (len(s) == 0): None else: s[0];

  # Returns the largest item, or None if empty.
  def last(s): if (len(s) == 0): None else: s[len(s) - 1];

  # Returns true if `x` is in the list.
  def contains(s, x):
    let i = lower_bound(s, x)
    | i < len(s) && s[i] == x;

  # Adds `x` after any equal items.
  def insert(s, x):
    let i = upper_bound(s, x)
    | s[0:i] + [x] + s[i:len(s)];

  # Removes one item equal to `x`, if any.
  def remove(s, x):
    let i = lower_bound(s, x)
    | if (i < len(s) && s[i] == x): s[0:i] + s[i + 1:len(s)] else: s;

  # Returns the first item that is not less than `x`, or None if there is none.
  def ceiling(s, x):
    let i = lower_bound(s, x)
    | if (i < len(s)): s[i] else: None;

  # Returns the last item that is not greater than `x`, or None if there is none.
  def floor_item(s, x):
    let i = upper_bound(s, x)
    | if (i > 0): s[i - 1] else: None;

  # Returns the items from `lo` up to but not including `hi`.
  def between(s, lo, hi): s[lower_bound(s, lo):lower_bound(s, hi)];
end
