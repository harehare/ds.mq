import "ds"
| include "test"

# Sorted copy of an array built with the heap, popping one item at a time.
def heap_sort(items, max):
  var h = ds::heap::new()
  | let _ = if (max): h = ds::heap::new_max() else: h = ds::heap::new()
  | var i = 0
  | let _ = while (i < len(items)):
      h = ds::heap::push(h, items[i])
      | i = i + 1
    end
  | var out = []
  | let _ = while (ds::heap::size(h) > 0):
      let r = ds::heap::pop(h)
      | out += [r[0]]
      | h = r[1]
    end
  | out
end

# A deterministic scrambled array of n distinct numbers.
def scrambled(n):
  var out = []
  | var i = 0
  | let _ = while (i < n):
      out += [(i * 37 + 11) % n]
      | i = i + 1
    end
  | out
end

# =========================================================================
# heap
# =========================================================================

def test_heap_new_is_empty():
  let h = ds::heap::new()
  | assert_eq(ds::heap::size(h), 0)
  | assert_none(ds::heap::peek(h))
end

def test_heap_push_tracks_size_and_root():
  let h1 = ds::heap::push(ds::heap::new(), 5)
  | let h2 = ds::heap::push(h1, 3)
  | let h3 = ds::heap::push(h2, 8)
  | assert_eq(ds::heap::size(h3), 3)
  | assert_eq(ds::heap::peek(h3), 3)
end

def test_heap_pop_returns_root_and_rest():
  let h = ds::heap::from([4, 1, 3], false)
  | let r = ds::heap::pop(h)
  | assert_eq(r[0], 1)
  | assert_eq(ds::heap::size(r[1]), 2)
  | assert_eq(ds::heap::peek(r[1]), 3)
end

def test_heap_pop_on_empty_fails():
  let r = try: ds::heap::pop(ds::heap::new()) catch: "failed"
  | assert_eq(r, "failed")
end

def test_heap_does_not_modify_the_original():
  let h = ds::heap::from([4, 1, 3], false)
  | let h2 = ds::heap::push(h, 0)
  | let r = ds::heap::pop(h)
  | assert_eq(ds::heap::size(h), 3)
  | assert_eq(ds::heap::peek(h), 1)
  | assert_eq(ds::heap::peek(h2), 0)
  | assert_eq(r[0], 1)
end

def test_heap_pops_in_ascending_order():
  assert_eq(heap_sort([5, 3, 8, 1, 9, 2, 7], false), [1, 2, 3, 5, 7, 8, 9])
end

def test_heap_max_pops_in_descending_order():
  assert_eq(heap_sort([5, 3, 8, 1, 9, 2, 7], true), [9, 8, 7, 5, 3, 2, 1])
end

def test_heap_keeps_duplicates():
  assert_eq(heap_sort([2, 1, 2, 1, 3, 3], false), [1, 1, 2, 2, 3, 3])
end

def test_heap_single_item():
  assert_eq(heap_sort([42], false), [42])
end

def test_heap_sorts_a_larger_scrambled_array():
  let items = scrambled(200)
  | assert_eq(heap_sort(items, false), sort(items))
end

def test_heap_orders_strings():
  assert_eq(heap_sort(["pear", "apple", "fig"], false), ["apple", "fig", "pear"])
end

def test_heap_orders_pairs_by_first_element():
  let h = ds::heap::from([[3, "c"], [1, "a"], [2, "b"]], false)
  | let r = ds::heap::pop(h)
  | assert_eq(r[0], [1, "a"])
end

def test_heap_reuses_capacity_after_pops():
  var h = ds::heap::from([5, 4, 3, 2, 1], false)
  | let r1 = ds::heap::pop(h)
  | let r2 = ds::heap::pop(r1[1])
  | let h2 = ds::heap::push(ds::heap::push(r2[1], 0), 10)
  | assert_eq(ds::heap::size(h2), 5)
  | assert_eq(ds::heap::to_sorted(h2), [0, 3, 4, 5, 10])
end

def test_heap_interleaved_push_and_pop():
  let h1 = ds::heap::from([10, 20, 30], false)
  | let r1 = ds::heap::pop(h1)
  | let h2 = ds::heap::push(r1[1], 5)
  | let r2 = ds::heap::pop(h2)
  | let h3 = ds::heap::push(r2[1], 25)
  | assert_eq(r1[0], 10)
  | assert_eq(r2[0], 5)
  | assert_eq(ds::heap::to_sorted(h3), [20, 25, 30])
end

def test_heap_from_empty_array():
  let h = ds::heap::from([], false)
  | assert_eq(ds::heap::size(h), 0)
  | assert_none(ds::heap::peek(h))
end

def test_heap_from_matches_repeated_push():
  let items = scrambled(60)
  | assert_eq(ds::heap::to_sorted(ds::heap::from(items, false)), sort(items))
end

def test_heap_from_max():
  let h = ds::heap::from([3, 9, 1], true)
  | assert_eq(ds::heap::peek(h), 9)
  | assert_eq(ds::heap::to_sorted(h), [9, 3, 1])
end

def test_heap_to_sorted_leaves_the_heap_intact():
  let h = ds::heap::from([3, 1, 2], false)
  | assert_eq(ds::heap::to_sorted(h), [1, 2, 3])
  | assert_eq(ds::heap::size(h), 3)
end

def test_heap_largest():
  assert_eq(ds::heap::largest([5, 1, 9, 3, 7, 2], 3), [9, 7, 5])
end

def test_heap_smallest():
  assert_eq(ds::heap::smallest([5, 1, 9, 3, 7, 2], 3), [1, 2, 3])
end

def test_heap_largest_and_smallest_with_k_beyond_length():
  assert_eq(ds::heap::largest([2, 1], 5), [2, 1])
  | assert_eq(ds::heap::smallest([2, 1], 5), [1, 2])
end

def test_heap_largest_and_smallest_with_non_positive_k():
  assert_eq(ds::heap::largest([2, 1], 0), [])
  | assert_eq(ds::heap::smallest([2, 1], -1), [])
end

def test_heap_largest_and_smallest_of_empty_array():
  assert_eq(ds::heap::largest([], 3), [])
  | assert_eq(ds::heap::smallest([], 3), [])
end

def test_heap_largest_with_duplicates():
  assert_eq(ds::heap::largest([4, 4, 4, 1], 2), [4, 4])
end

def test_heap_largest_and_smallest_agree_with_sort():
  let items = scrambled(100)
  | assert_eq(ds::heap::largest(items, 10), slice(reverse(sort(items)), 0, 10))
  | assert_eq(ds::heap::smallest(items, 10), slice(sort(items), 0, 10))
end

# =========================================================================
# trie
# =========================================================================

def sample_trie():
  var t = ds::trie::new()
  | let _ = foreach(w, ["car", "card", "care", "cat", "dog"]): t = ds::trie::insert(t, w);
  | t
end

def test_trie_contains_inserted_words_only():
  let t = sample_trie()
  | assert_true(ds::trie::contains(t, "car"))
  | assert_true(ds::trie::contains(t, "card"))
  | assert_false(ds::trie::contains(t, "ca"))
  | assert_false(ds::trie::contains(t, "cars"))
  | assert_false(ds::trie::contains(t, "zebra"))
end

def test_trie_empty_trie_contains_nothing():
  let t = ds::trie::new()
  | assert_false(ds::trie::contains(t, "a"))
  | assert_false(ds::trie::contains(t, ""))
  | assert_eq(ds::trie::words(t, ""), [])
end

def test_trie_has_prefix():
  let t = sample_trie()
  | assert_true(ds::trie::has_prefix(t, "ca"))
  | assert_true(ds::trie::has_prefix(t, "car"))
  | assert_true(ds::trie::has_prefix(t, ""))
  | assert_false(ds::trie::has_prefix(t, "cb"))
  | assert_false(ds::trie::has_prefix(t, "cars"))
end

def test_trie_words_with_prefix_are_sorted():
  let t = sample_trie()
  | assert_eq(ds::trie::words(t, "car"), ["car", "card", "care"])
  | assert_eq(ds::trie::words(t, "ca"), ["car", "card", "care", "cat"])
  | assert_eq(ds::trie::words(t, "d"), ["dog"])
end

def test_trie_words_of_whole_trie():
  assert_eq(ds::trie::words(sample_trie(), ""), ["car", "card", "care", "cat", "dog"])
end

def test_trie_words_with_unknown_prefix():
  assert_eq(ds::trie::words(sample_trie(), "x"), [])
end

def test_trie_insert_is_idempotent():
  let t = ds::trie::insert(sample_trie(), "car")
  | assert_eq(ds::trie::words(t, "car"), ["car", "card", "care"])
end

def test_trie_insert_does_not_modify_the_original():
  let t = sample_trie()
  | let t2 = ds::trie::insert(t, "cow")
  | assert_false(ds::trie::contains(t, "cow"))
  | assert_true(ds::trie::contains(t2, "cow"))
end

def test_trie_put_and_lookup():
  let t = ds::trie::put(ds::trie::put(ds::trie::new(), "mq", "markdown query"), "jq", "json query")
  | assert_eq(ds::trie::lookup(t, "mq"), "markdown query")
  | assert_eq(ds::trie::lookup(t, "jq"), "json query")
  | assert_none(ds::trie::lookup(t, "m"))
  | assert_none(ds::trie::lookup(t, "xx"))
end

def test_trie_put_overwrites_the_value():
  let t = ds::trie::put(ds::trie::put(ds::trie::new(), "k", 1), "k", 2)
  | assert_eq(ds::trie::lookup(t, "k"), 2)
end

def test_trie_put_keeps_a_longer_word_through_a_shorter_one():
  let t = ds::trie::put(ds::trie::put(ds::trie::new(), "abc", 1), "ab", 2)
  | assert_eq(ds::trie::lookup(t, "abc"), 1)
  | assert_eq(ds::trie::lookup(t, "ab"), 2)
end

def test_trie_handles_non_ascii_words():
  let t = ds::trie::insert(ds::trie::insert(ds::trie::new(), "日本"), "日本語")
  | assert_true(ds::trie::contains(t, "日本"))
  | assert_true(ds::trie::contains(t, "日本語"))
  | assert_false(ds::trie::contains(t, "日"))
  | assert_eq(ds::trie::words(t, "日"), ["日本", "日本語"])
end

def test_trie_longest_match_prefers_the_longest_word():
  let t = sample_trie()
  | assert_eq(ds::trie::longest_match(t, "cardigan", 0), 4)
  | assert_eq(ds::trie::longest_match(t, "carton", 0), 3)
end

def test_trie_longest_match_at_an_offset():
  let t = sample_trie()
  | assert_eq(ds::trie::longest_match(t, "a cat sat", 2), 5)
  | assert_eq(ds::trie::longest_match(t, "my dog", 3), 6)
end

def test_trie_longest_match_returns_none_without_a_word():
  let t = sample_trie()
  | assert_none(ds::trie::longest_match(t, "ca", 0))
  | assert_none(ds::trie::longest_match(t, "xyz", 0))
  | assert_none(ds::trie::longest_match(t, "", 0))
end

def test_trie_longest_match_stops_at_the_end_of_the_string():
  let t = sample_trie()
  | assert_eq(ds::trie::longest_match(t, "car", 0), 3)
  | assert_eq(ds::trie::longest_match(t, "xcard", 1), 5)
end

# =========================================================================
# unionfind
# =========================================================================

def test_unionfind_starts_with_singletons():
  let uf = ds::unionfind::new(4)
  | assert_eq(ds::unionfind::count(uf), 4)
  | assert_false(ds::unionfind::connected(uf, 0, 1))
  | assert_true(ds::unionfind::connected(uf, 2, 2))
  | assert_eq(ds::unionfind::size_of(uf, 3), 1)
end

def test_unionfind_union_connects():
  let uf = ds::unionfind::union(ds::unionfind::new(4), 0, 1)
  | assert_true(ds::unionfind::connected(uf, 0, 1))
  | assert_false(ds::unionfind::connected(uf, 0, 2))
  | assert_eq(ds::unionfind::count(uf), 3)
end

def test_unionfind_is_transitive():
  let uf = ds::unionfind::union(ds::unionfind::union(ds::unionfind::new(5), 0, 1), 1, 2)
  | assert_true(ds::unionfind::connected(uf, 0, 2))
  | assert_eq(ds::unionfind::size_of(uf, 0), 3)
  | assert_eq(ds::unionfind::size_of(uf, 2), 3)
  | assert_eq(ds::unionfind::count(uf), 3)
end

def test_unionfind_union_of_connected_elements_changes_nothing():
  let uf = ds::unionfind::union(ds::unionfind::new(3), 0, 1)
  | assert_eq(ds::unionfind::union(uf, 1, 0), uf)
  | assert_eq(ds::unionfind::union(uf, 0, 0), uf)
end

def test_unionfind_does_not_modify_the_original():
  let uf = ds::unionfind::new(3)
  | let uf2 = ds::unionfind::union(uf, 0, 1)
  | assert_false(ds::unionfind::connected(uf, 0, 1))
  | assert_true(ds::unionfind::connected(uf2, 0, 1))
end

def test_unionfind_merges_two_larger_sets():
  let a = ds::unionfind::union(ds::unionfind::union(ds::unionfind::new(6), 0, 1), 1, 2)
  | let b = ds::unionfind::union(a, 3, 4)
  | let c = ds::unionfind::union(b, 4, 2)
  | assert_eq(ds::unionfind::size_of(c, 3), 5)
  | assert_eq(ds::unionfind::count(c), 2)
  | assert_true(ds::unionfind::connected(c, 0, 4))
  | assert_false(ds::unionfind::connected(c, 0, 5))
end

def test_unionfind_find_is_stable_within_a_set():
  let uf = ds::unionfind::from_pairs(5, [[0, 1], [2, 1], [3, 2]])
  | let root = ds::unionfind::find(uf, 0)
  | assert_eq(ds::unionfind::find(uf, 1), root)
  | assert_eq(ds::unionfind::find(uf, 2), root)
  | assert_eq(ds::unionfind::find(uf, 3), root)
  | assert_ne(ds::unionfind::find(uf, 4), root)
end

def test_unionfind_groups():
  let uf = ds::unionfind::from_pairs(6, [[0, 2], [1, 4], [2, 5]])
  | assert_eq(ds::unionfind::groups(uf), [[0, 2, 5], [1, 4], [3]])
end

def test_unionfind_groups_of_singletons():
  assert_eq(ds::unionfind::groups(ds::unionfind::new(3)), [[0], [1], [2]])
end

def test_unionfind_from_pairs_without_pairs():
  assert_eq(ds::unionfind::count(ds::unionfind::from_pairs(4, [])), 4)
end

def test_unionfind_chain_collapses_to_one_set():
  let n = 50
  | let pairs = map(range(n - 2), fn(i): [i, i + 1];)
  | let uf = ds::unionfind::from_pairs(n, pairs)
  | assert_eq(ds::unionfind::count(uf), 1)
  | assert_eq(ds::unionfind::size_of(uf, 0), n)
  | assert_true(ds::unionfind::connected(uf, 0, n - 1))
end

def test_unionfind_find_rejects_out_of_range_elements():
  let uf = ds::unionfind::new(3)
  | assert_eq(try: ds::unionfind::find(uf, 3) catch: "failed", "failed")
  | assert_eq(try: ds::unionfind::find(uf, -1) catch: "failed", "failed")
  | assert_eq(try: ds::unionfind::union(uf, 0, 9) catch: "failed", "failed")
end

def test_unionfind_new_zero_is_empty():
  let uf = ds::unionfind::new(0)
  | assert_eq(ds::unionfind::count(uf), 0)
  | assert_eq(ds::unionfind::groups(uf), [])
end
